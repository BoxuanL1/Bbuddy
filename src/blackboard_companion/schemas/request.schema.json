{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "course": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "input_dir": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string"
    },
    "original_request": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "course",
    "scope"
  ],
  "additionalProperties": false
}
