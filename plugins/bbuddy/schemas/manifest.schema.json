{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "normalizer_version": {
      "type": "string",
      "minLength": 1
    },
    "input_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "captions",
              "document",
              "text"
            ]
          },
          "recording_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "units_path": {
            "type": "string",
            "minLength": 1
          },
          "units_sha256": {
            "type": "string",
            "minLength": 1
          },
          "unit_count": {
            "type": "integer",
            "minimum": 1
          },
          "identity": {
            "type": "object"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "recording_id",
          "sha256",
          "path",
          "units_path",
          "units_sha256",
          "unit_count",
          "identity",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "source_id",
          "path",
          "sha256",
          "unit_ids"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "normalizer_version",
    "input_fingerprint",
    "scope",
    "sources",
    "chunks",
    "warnings",
    "missing"
  ],
  "additionalProperties": false
}
